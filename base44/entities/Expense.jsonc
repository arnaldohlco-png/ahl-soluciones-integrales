{
  "name": "Expense",
  "type": "object",
  "properties": {
    "date": {
      "type": "string",
      "format": "date",
      "title": "Fecha"
    },
    "category": {
      "type": "string",
      "title": "Categor\u00eda",
      "enum": [
        "Arriendo",
        "Servicios p\u00fablicos",
        "N\u00f3mina",
        "Transporte",
        "Herramientas",
        "Papeler\u00eda",
        "Publicidad",
        "Mantenimiento",
        "Compras menores",
        "Otros"
      ],
      "default": "Otros"
    },
    "description": {
      "type": "string",
      "title": "Descripci\u00f3n"
    },
    "amount": {
      "type": "number",
      "title": "Valor"
    },
    "responsible": {
      "type": "string",
      "title": "Responsable"
    },
    "payment_method": {
      "type": "string",
      "title": "Forma de pago",
      "enum": [
        "Efectivo",
        "Transferencia",
        "Tarjeta",
        "Otros"
      ],
      "default": "Efectivo"
    },
    "support_photo": {
      "type": "string",
      "title": "Soporte/Foto"
    }
  },
  "required": [
    "date",
    "category",
    "amount"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "administrador"
          }
        },
        {
          "user_condition": {
            "role": "gerente"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "administrador"
          }
        },
        {
          "user_condition": {
            "role": "gerente"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "administrador"
          }
        },
        {
          "user_condition": {
            "role": "gerente"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "administrador"
          }
        },
        {
          "user_condition": {
            "role": "gerente"
          }
        }
      ]
    }
  }
}