{
  "name": "Invoice",
  "type": "object",
  "properties": {
    "customer_id": {
      "type": "string",
      "title": "Cliente"
    },
    "customer_name": {
      "type": "string",
      "title": "Nombre del cliente"
    },
    "type": {
      "type": "string",
      "title": "Tipo de documento",
      "enum": [
        "Factura de venta",
        "Cotizaci\u00f3n",
        "Proforma",
        "Nota cr\u00e9dito",
        "Recibo de pago",
        "Comprobante de abono",
        "Factura de taller"
      ],
      "default": "Factura de venta"
    },
    "number": {
      "type": "string",
      "title": "N\u00famero"
    },
    "date": {
      "type": "string",
      "format": "date",
      "title": "Fecha"
    },
    "items": {
      "type": "string",
      "title": "Items (JSON)"
    },
    "subtotal": {
      "type": "number",
      "title": "Subtotal"
    },
    "iva": {
      "type": "number",
      "title": "IVA"
    },
    "discount": {
      "type": "number",
      "title": "Descuento",
      "default": 0
    },
    "total": {
      "type": "number",
      "title": "Total"
    },
    "anticipo": {
      "type": "number",
      "title": "Anticipo aplicado",
      "default": 0
    },
    "status": {
      "type": "string",
      "title": "Estado",
      "enum": [
        "Pendiente",
        "Pagada",
        "Anulada"
      ],
      "default": "Pendiente"
    },
    "payment_terms": {
      "type": "string",
      "title": "Plazo de pago",
      "enum": [
        "Contado",
        "Cr\u00e9dito"
      ],
      "default": "Contado"
    },
    "credit_days": {
      "type": "number",
      "title": "D\u00edas de cr\u00e9dito",
      "default": 0
    },
    "installments": {
      "type": "number",
      "title": "N\u00famero de cuotas",
      "default": 1
    },
    "installment_amount": {
      "type": "number",
      "title": "Valor por cuota",
      "default": 0
    },
    "payment_due_date": {
      "type": "string",
      "format": "date",
      "title": "Fecha de vencimiento"
    },
    "amount_paid": {
      "type": "number",
      "title": "Recibido",
      "default": 0
    },
    "change": {
      "type": "number",
      "title": "Cambio/Vueltas",
      "default": 0
    },
    "related_sale_id": {
      "type": "string",
      "title": "Venta relacionada"
    },
    "related_order_id": {
      "type": "string",
      "title": "Orden relacionada"
    },
    "commission_paid_techs": {
      "type": "string",
      "title": "T\u00e9cnicos con comisi\u00f3n pagada (JSON)"
    }
  },
  "required": [
    "date",
    "type",
    "total"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "administrador"
          }
        },
        {
          "user_condition": {
            "role": "gerente"
          }
        },
        {
          "user_condition": {
            "role": "vendedor"
          }
        },
        {
          "user_condition": {
            "role": "tecnico"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "administrador"
          }
        },
        {
          "user_condition": {
            "role": "gerente"
          }
        },
        {
          "user_condition": {
            "role": "vendedor"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "administrador"
          }
        },
        {
          "user_condition": {
            "role": "gerente"
          }
        },
        {
          "user_condition": {
            "role": "vendedor"
          }
        },
        {
          "user_condition": {
            "role": "tecnico"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "administrador"
          }
        },
        {
          "user_condition": {
            "role": "gerente"
          }
        },
        {
          "user_condition": {
            "role": "vendedor"
          }
        },
        {
          "user_condition": {
            "role": "tecnico"
          }
        }
      ]
    }
  }
}