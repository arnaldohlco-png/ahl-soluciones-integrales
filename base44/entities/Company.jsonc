{
  "name": "Company",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Nombre / Raz\u00f3n social"
    },
    "document_type": {
      "type": "string",
      "title": "Tipo de persona",
      "enum": [
        "Persona natural",
        "Persona jur\u00eddica"
      ],
      "default": "Persona jur\u00eddica"
    },
    "document_number": {
      "type": "string",
      "title": "NIT / C\u00e9dula"
    },
    "phone": {
      "type": "string",
      "title": "Tel\u00e9fono"
    },
    "email": {
      "type": "string",
      "title": "Email",
      "format": "email"
    },
    "address": {
      "type": "string",
      "title": "Direcci\u00f3n"
    },
    "city": {
      "type": "string",
      "title": "Ciudad"
    },
    "logo": {
      "type": "string",
      "title": "Logo (URL)"
    },
    "footer_text": {
      "type": "string",
      "title": "Pie de p\u00e1gina para \u00f3rdenes de servicio",
      "description": "Texto que aparece al pie de las \u00f3rdenes de servicio"
    },
    "receipt_footer_text": {
      "type": "string",
      "title": "Pie de p\u00e1gina POS y facturas",
      "description": "Texto editable por admin al final de comprobantes POS y facturas"
    },
    "credit_default_days": {
      "type": "number",
      "title": "D\u00edas de cr\u00e9dito por defecto",
      "default": 30
    },
    "charges_iva": {
      "type": "boolean",
      "title": "Responsable de IVA",
      "default": true
    },
    "dian_resolution": {
      "type": "string",
      "title": "N\u00famero de resoluci\u00f3n DIAN"
    },
    "dian_resolution_date": {
      "type": "string",
      "format": "date",
      "title": "Fecha de resoluci\u00f3n DIAN"
    },
    "dian_range_from": {
      "type": "number",
      "title": "Rango desde",
      "default": 0
    },
    "dian_range_to": {
      "type": "number",
      "title": "Rango hasta",
      "default": 0
    },
    "pos_prefix": {
      "type": "string",
      "title": "Prefijo facturas POS (ventas)",
      "default": "VTA"
    },
    "quote_prefix": {
      "type": "string",
      "title": "Prefijo cotizaciones",
      "default": "COT"
    },
    "purchase_prefix": {
      "type": "string",
      "title": "Prefijo compras",
      "default": "COMP"
    },
    "order_prefix": {
      "type": "string",
      "title": "Prefijo \u00f3rdenes de servicio",
      "default": "ORD"
    },
    "invoice_prefix": {
      "type": "string",
      "title": "Prefijo facturas",
      "default": "FAC"
    },
    "supplier_order_prefix": {
      "type": "string",
      "title": "Prefijo pedidos a proveedor",
      "default": "PED"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "administrador"
          }
        },
        {
          "user_condition": {
            "role": "gerente"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "administrador"
          }
        },
        {
          "user_condition": {
            "role": "gerente"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "administrador"
          }
        },
        {
          "user_condition": {
            "role": "gerente"
          }
        }
      ]
    }
  }
}