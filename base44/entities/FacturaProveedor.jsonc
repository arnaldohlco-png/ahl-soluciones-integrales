{
  "name": "FacturaProveedor",
  "type": "object",
  "properties": {
    "supplier_id": {
      "type": "string",
      "title": "Proveedor"
    },
    "supplier_name": {
      "type": "string",
      "title": "Nombre del proveedor"
    },
    "invoice_number": {
      "type": "string",
      "title": "N\u00famero de factura"
    },
    "date": {
      "type": "string",
      "format": "date",
      "title": "Fecha"
    },
    "items": {
      "type": "string",
      "title": "L\u00edneas (JSON)",
      "description": "Array JSON: [{sku, description, quantity, unit_price, subtotal}]"
    },
    "subtotal": {
      "type": "number",
      "title": "Subtotal",
      "default": 0
    },
    "iva_total": {
      "type": "number",
      "title": "IVA total",
      "default": 0
    },
    "total": {
      "type": "number",
      "title": "Total",
      "default": 0
    },
    "pdf_url": {
      "type": "string",
      "title": "PDF (URI privada)"
    },
    "purchase_id": {
      "type": "string",
      "title": "Compra vinculada"
    },
    "payment_type": {
      "type": "string",
      "title": "Tipo de pago",
      "enum": [
        "Contado",
        "Cr\u00e9dito"
      ],
      "default": "Contado"
    },
    "credit_days": {
      "type": "number",
      "title": "D\u00edas de cr\u00e9dito",
      "default": 0
    },
    "payment_due_date": {
      "type": "string",
      "format": "date",
      "title": "Fecha de vencimiento"
    },
    "status": {
      "type": "string",
      "title": "Estado",
      "enum": [
        "Aplicada",
        "Anulada"
      ],
      "default": "Aplicada"
    }
  },
  "required": [
    "date",
    "total"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "administrador"
          }
        },
        {
          "user_condition": {
            "role": "gerente"
          }
        },
        {
          "user_condition": {
            "role": "vendedor"
          }
        }
      ]
    },
    "read": {},
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "administrador"
          }
        },
        {
          "user_condition": {
            "role": "gerente"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "administrador"
          }
        },
        {
          "user_condition": {
            "role": "gerente"
          }
        }
      ]
    }
  }
}