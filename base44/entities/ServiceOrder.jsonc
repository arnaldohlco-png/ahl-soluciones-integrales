{
  "name": "ServiceOrder",
  "type": "object",
  "properties": {
    "number": {
      "type": "string",
      "title": "N\u00famero de orden"
    },
    "motorcycle_id": {
      "type": "string",
      "title": "Motocicleta",
      "description": "ID de la motocicleta"
    },
    "customer_id": {
      "type": "string",
      "title": "Cliente",
      "description": "ID del cliente"
    },
    "service_type": {
      "type": "string",
      "title": "Tipo de servicio",
      "default": "Mantenimiento"
    },
    "description": {
      "type": "string",
      "title": "Descripci\u00f3n del trabajo"
    },
    "status": {
      "type": "string",
      "title": "Estado",
      "enum": [
        "Ingresado",
        "En proceso",
        "Terminado",
        "Entregado"
      ],
      "default": "Ingresado"
    },
    "mechanic": {
      "type": "string",
      "title": "Mec\u00e1nico asignado"
    },
    "technician_id": {
      "type": "string",
      "title": "T\u00e9cnico responsable"
    },
    "entry_date": {
      "type": "string",
      "format": "date",
      "title": "Fecha de ingreso"
    },
    "entry_time": {
      "type": "string",
      "title": "Hora de ingreso"
    },
    "fuel_level": {
      "type": "string",
      "title": "Nivel de combustible",
      "enum": [
        "1/4",
        "1/2",
        "3/4",
        "Full"
      ],
      "default": "1/2"
    },
    "visual_condition": {
      "type": "string",
      "title": "Estado visual"
    },
    "accessories": {
      "type": "string",
      "title": "Accesorios entregados"
    },
    "photos": {
      "type": "string",
      "title": "Fotos de la moto"
    },
    "customer_complaint": {
      "type": "string",
      "title": "Queja del cliente"
    },
    "reported_fault": {
      "type": "string",
      "title": "Falla reportada"
    },
    "technical_diagnosis": {
      "type": "string",
      "title": "Diagn\u00f3stico t\u00e9cnico"
    },
    "recommendations": {
      "type": "string",
      "title": "Recomendaciones"
    },
    "tests_performed": {
      "type": "string",
      "title": "Pruebas realizadas"
    },
    "labor_description": {
      "type": "string",
      "title": "Descripci\u00f3n de mano de obra"
    },
    "labor_cost": {
      "type": "number",
      "title": "Costo de mano de obra"
    },
    "parts_cost": {
      "type": "number",
      "title": "Costo de repuestos"
    },
    "lubricants_cost": {
      "type": "number",
      "title": "Costo de lubricantes"
    },
    "hours_worked": {
      "type": "number",
      "title": "Horas trabajadas"
    },
    "technician_commission": {
      "type": "number",
      "title": "Comisi\u00f3n del t\u00e9cnico"
    },
    "work_done": {
      "type": "string",
      "title": "Trabajo realizado"
    },
    "delivery_recommendations": {
      "type": "string",
      "title": "Recomendaciones de entrega"
    },
    "warranty": {
      "type": "string",
      "title": "Garant\u00eda"
    },
    "customer_signature": {
      "type": "string",
      "title": "Firma digital del cliente",
      "description": "Data URL (PNG) de la firma del cliente"
    },
    "technician_signature": {
      "type": "string",
      "title": "Firma digital del t\u00e9cnico",
      "description": "Data URL (PNG) de la firma del t\u00e9cnico"
    },
    "delivery_date": {
      "type": "string",
      "format": "date",
      "title": "Fecha de entrega"
    },
    "cost": {
      "type": "number",
      "title": "Costo total"
    },
    "parts_used": {
      "type": "string",
      "title": "Repuestos utilizados"
    },
    "previous_mileage": {
      "type": "number",
      "title": "Kilometraje anterior"
    },
    "current_mileage": {
      "type": "number",
      "title": "Kilometraje actual"
    },
    "kms_traveled": {
      "type": "number",
      "title": "Km recorridos",
      "default": 0
    },
    "oil_change_interval": {
      "type": "number",
      "title": "Intervalo cambio de aceite (km)",
      "enum": [
        1000,
        1500,
        2000
      ],
      "default": 1000
    },
    "next_oil_change": {
      "type": "number",
      "title": "Pr\u00f3ximo cambio de aceite (km)"
    },
    "service_items": {
      "type": "string",
      "title": "Items (productos y servicios)",
      "description": "JSON: [{type, name, quantity, unit_price, subtotal, product_id?}]"
    },
    "anticipos": {
      "type": "string",
      "title": "Anticipos (JSON)",
      "description": "Array JSON de anticipos: [{date, amount, method}]"
    },
    "admin_footer": {
      "type": "string",
      "title": "Pie de p\u00e1gina admin"
    },
    "commission_paid": {
      "type": "boolean",
      "title": "Comisi\u00f3n pagada",
      "default": false
    },
    "warranty_snapshot": {
      "type": "string",
      "title": "Garant\u00eda: copia de t\u00e9rminos (JSON)",
      "description": "JSON {terms, coverage, exclusions, date} usado en esta orden"
    }
  },
  "required": [
    "motorcycle_id",
    "customer_id",
    "service_type",
    "status"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "administrador"
          }
        },
        {
          "user_condition": {
            "role": "gerente"
          }
        },
        {
          "user_condition": {
            "role": "vendedor"
          }
        },
        {
          "user_condition": {
            "role": "tecnico"
          }
        }
      ]
    },
    "read": null,
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "administrador"
          }
        },
        {
          "user_condition": {
            "role": "gerente"
          }
        },
        {
          "user_condition": {
            "role": "vendedor"
          }
        },
        {
          "user_condition": {
            "role": "tecnico"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "administrador"
          }
        },
        {
          "user_condition": {
            "role": "gerente"
          }
        },
        {
          "user_condition": {
            "role": "vendedor"
          }
        },
        {
          "user_condition": {
            "role": "tecnico"
          }
        }
      ]
    }
  }
}