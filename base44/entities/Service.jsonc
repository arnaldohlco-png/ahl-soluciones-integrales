{
  "name": "Service",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Nombre del servicio"
    },
    "category": {
      "type": "string",
      "title": "Categor\u00eda",
      "default": "Otros"
    },
    "price": {
      "type": "number",
      "title": "Precio",
      "default": 0
    },
    "cost": {
      "type": "number",
      "title": "Costo estimado",
      "default": 0
    },
    "estimated_hours": {
      "type": "number",
      "title": "Horas estimadas",
      "default": 0
    },
    "iva_rate": {
      "type": "number",
      "title": "IVA (%)",
      "default": 0
    },
    "description": {
      "type": "string",
      "title": "Descripci\u00f3n"
    },
    "status": {
      "type": "string",
      "title": "Estado",
      "enum": [
        "Activo",
        "Inactivo"
      ],
      "default": "Activo"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "administrador"
          }
        },
        {
          "user_condition": {
            "role": "gerente"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "administrador"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "administrador"
          }
        },
        {
          "user_condition": {
            "role": "gerente"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "administrador"
          }
        },
        {
          "user_condition": {
            "role": "gerente"
          }
        }
      ]
    }
  }
}