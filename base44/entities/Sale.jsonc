{
  "name": "Sale",
  "type": "object",
  "properties": {
    "number": {
      "type": "string",
      "title": "N\u00famero de factura"
    },
    "customer_id": {
      "type": "string",
      "title": "Cliente"
    },
    "customer_name": {
      "type": "string",
      "title": "Nombre del cliente"
    },
    "date": {
      "type": "string",
      "format": "date",
      "title": "Fecha"
    },
    "items": {
      "type": "string",
      "title": "Productos (JSON)",
      "description": "Array JSON de items: [{product_id, name, quantity, unit_price, iva_rate, subtotal}]"
    },
    "subtotal": {
      "type": "number",
      "title": "Subtotal"
    },
    "iva_total": {
      "type": "number",
      "title": "IVA total"
    },
    "discount": {
      "type": "number",
      "title": "Descuento",
      "default": 0
    },
    "total": {
      "type": "number",
      "title": "Total"
    },
    "anticipo": {
      "type": "number",
      "title": "Anticipo aplicado",
      "default": 0
    },
    "payment_method": {
      "type": "string",
      "title": "Medio de pago",
      "enum": [
        "Efectivo",
        "Transferencia",
        "Tarjeta",
        "Otros"
      ],
      "default": "Efectivo"
    },
    "payment_type": {
      "type": "string",
      "title": "Tipo de pago",
      "enum": [
        "Contado",
        "Cr\u00e9dito"
      ],
      "default": "Contado"
    },
    "status": {
      "type": "string",
      "title": "Estado",
      "enum": [
        "Pagada",
        "Pendiente"
      ],
      "default": "Pagada"
    },
    "balance": {
      "type": "number",
      "title": "Saldo",
      "default": 0
    },
    "amount_paid": {
      "type": "number",
      "title": "Recibido",
      "default": 0
    },
    "change": {
      "type": "number",
      "title": "Cambio/Vueltas",
      "default": 0
    },
    "related_order_id": {
      "type": "string",
      "title": "Orden de servicio relacionada"
    }
  },
  "required": [
    "date",
    "total",
    "payment_type"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "administrador"
          }
        },
        {
          "user_condition": {
            "role": "gerente"
          }
        },
        {
          "user_condition": {
            "role": "vendedor"
          }
        },
        {
          "user_condition": {
            "role": "tecnico"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "administrador"
          }
        },
        {
          "user_condition": {
            "role": "gerente"
          }
        },
        {
          "user_condition": {
            "role": "vendedor"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "administrador"
          }
        },
        {
          "user_condition": {
            "role": "gerente"
          }
        },
        {
          "user_condition": {
            "role": "vendedor"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "administrador"
          }
        },
        {
          "user_condition": {
            "role": "gerente"
          }
        },
        {
          "user_condition": {
            "role": "vendedor"
          }
        }
      ]
    }
  }
}