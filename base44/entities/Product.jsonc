{
  "name": "Product",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "title": "Descripci\u00f3n"
    },
    "category": {
      "type": "string",
      "title": "Categor\u00eda",
      "enum": [
        "Repuestos",
        "Accesorios",
        "Lubricantes",
        "Llantas",
        "Bater\u00edas",
        "Consumibles",
        "Herramientas",
        "Indumentaria",
        "Otros"
      ],
      "default": "Repuestos"
    },
    "brand": {
      "type": "string",
      "title": "Marca"
    },
    "sku": {
      "type": "string",
      "title": "C\u00f3digo"
    },
    "barcode": {
      "type": "string",
      "title": "C\u00f3digo de barras"
    },
    "reference": {
      "type": "string",
      "title": "Referencia"
    },
    "compatibility": {
      "type": "string",
      "title": "Compatibilidad"
    },
    "price": {
      "type": "number",
      "title": "Precio de venta"
    },
    "cost": {
      "type": "number",
      "title": "Costo"
    },
    "iva_rate": {
      "type": "number",
      "title": "IVA (%)",
      "default": 19
    },
    "stock": {
      "type": "number",
      "title": "Existencia",
      "default": 0
    },
    "min_stock": {
      "type": "number",
      "title": "Stock m\u00ednimo",
      "default": 5
    },
    "location": {
      "type": "string",
      "title": "Ubicaci\u00f3n"
    },
    "supplier_id": {
      "type": "string",
      "title": "Proveedor"
    },
    "description": {
      "type": "string",
      "title": "Descripci\u00f3n detallada"
    }
  },
  "required": [
    "name",
    "price",
    "stock"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "data.sede_id": "{{user.role}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "administrador"
          }
        },
        {
          "user_condition": {
            "role": "gerente"
          }
        },
        {
          "user_condition": {
            "role": "vendedor"
          }
        },
        {
          "user_condition": {
            "role": "tecnico"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "data.sede_id": "{{user.role}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "administrador"
          }
        },
        {
          "user_condition": {
            "role": "gerente"
          }
        },
        {
          "user_condition": {
            "role": "vendedor"
          }
        },
        {
          "user_condition": {
            "role": "tecnico"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "data.sede_id": "{{user.role}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "administrador"
          }
        },
        {
          "user_condition": {
            "role": "gerente"
          }
        },
        {
          "user_condition": {
            "role": "vendedor"
          }
        },
        {
          "user_condition": {
            "role": "tecnico"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "data.sede_id": "{{user.role}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "administrador"
          }
        },
        {
          "user_condition": {
            "role": "gerente"
          }
        },
        {
          "user_condition": {
            "role": "vendedor"
          }
        },
        {
          "user_condition": {
            "role": "tecnico"
          }
        }
      ]
    }
  }
}