{
  "name": "TechnicianLoan",
  "type": "object",
  "properties": {
    "technician_id": {
      "type": "string",
      "title": "T\u00e9cnico"
    },
    "technician_name": {
      "type": "string",
      "title": "Nombre del t\u00e9cnico"
    },
    "date": {
      "type": "string",
      "format": "date",
      "title": "Fecha"
    },
    "amount": {
      "type": "number",
      "title": "Monto del pr\u00e9stamo"
    },
    "description": {
      "type": "string",
      "title": "Descripci\u00f3n / Motivo"
    },
    "deducted_amount": {
      "type": "number",
      "title": "Monto descontado",
      "default": 0
    },
    "balance": {
      "type": "number",
      "title": "Saldo pendiente",
      "default": 0
    },
    "payments": {
      "type": "string",
      "title": "Abonos (JSON)",
      "description": "Array JSON: [{date, amount, method, note}]"
    },
    "status": {
      "type": "string",
      "title": "Estado",
      "enum": [
        "Pendiente",
        "Descontado"
      ],
      "default": "Pendiente"
    }
  },
  "required": [
    "technician_id",
    "date",
    "amount"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "administrador"
          }
        },
        {
          "user_condition": {
            "role": "gerente"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "administrador"
          }
        },
        {
          "user_condition": {
            "role": "gerente"
          }
        },
        {
          "user_condition": {
            "role": "tecnico"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "administrador"
          }
        },
        {
          "user_condition": {
            "role": "gerente"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "administrador"
          }
        },
        {
          "user_condition": {
            "role": "gerente"
          }
        }
      ]
    }
  }
}